<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Verification | Satyam Computer Institute</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/" class="logo">Satyam Computer Institute</a>
      <p class="tagline">Student Verification Portal</p>
    </div>
  </header>
  <main class="main-content">
    <p style="margin-bottom: 1rem;"><a href="/" class="btn-secondary" style="margin-bottom: 0;">&larr; Back to Home</a></p>
    <section class="hero">
      <h1>Verify Student</h1>
      <p class="lead">Enter the enrollment number to verify student details and view marksheet.</p>
    </section>
    <section class="search-card">
      <form action="/verify" method="post" class="verify-form">
        <label for="enrollmentId">Enrollment Number</label>
        <input
          type="text"
          id="enrollmentId"
          name="enrollmentId"
          value="<%= typeof enrollmentId !== 'undefined' ? enrollmentId : '' %>"
          placeholder="e.g. E64953"
          autocomplete="off"
          required
        >
        <% if (typeof error !== 'undefined' && error) { %>
          <p class="form-error"><%= error %></p>
        <% } %>
        <button type="submit" class="btn-primary">Verify Student</button>
      </form>
    </section>
  </main>
  <footer class="site-footer">
    <div class="container">
      <p>&copy; <%= new Date().getFullYear() %> Satyam Computer Institute. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>
