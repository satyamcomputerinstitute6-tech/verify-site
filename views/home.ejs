<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home | Satyam Computer Institute</title>
  <meta name="description" content="Satyam Computer Institute – Quality computer education, certifications, and student verification.">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Top bar (Glaxdu-style) -->
  <div class="topbar">
    <div class="container topbar__inner">
      <div class="topbar__left">
        <a href="tel:+919781187687" class="topbar__link">+91 9781187687</a>
        <a href="mailto:satyamcomputerinstitute6@gmail.com" class="topbar__link">satyamcomputerinstitute6@gmail.com</a>
      </div>
      <div class="topbar__right">
        <a href="/">Home</a>
        <a href="#verify-student">Verify Student</a>
      </div>
    </div>
  </div>

  <header class="site-header">
    <div class="container site-header__inner">
      <a href="/" class="logo-wrap">
        <span class="logo-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="36" height="36" rx="8" fill="currentColor" opacity="0.15"/><path d="M12 12h4v12h-4V12zm8 0h4v12h-4V12zM12 10V8h12v2H12z" fill="currentColor"/></svg>
        </span>
        <span class="logo-text">Satyam Computer Institute</span>
      </a>
      <p class="tagline">ISO 9001 : 2015 Certified</p>
      <nav class="header-nav">
        <a href="/">Home</a>
        <a href="#about">About</a>
        <a href="#courses">Courses</a>
        <a href="#services">Services</a>
        <a href="#verify-student">Verify Student</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <section class="hero">
    <div class="hero__bg" role="presentation">
      <img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?w=1600&q=80" alt="" class="hero__img" fetchpriority="high">
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content container">
      <h1 class="hero__title">Make Your Own World</h1>
      <p class="hero__subtitle">Empowering students with industry-relevant computer skills and recognized certifications. Quality education for a brighter future.</p>
      <div class="hero__btns">
        <a href="#about" class="btn btn--white">About Us</a>
        <a href="#verify-student" class="btn btn--primary btn--lg">Verify Student</a>
      </div>
    </div>
  </section>

  <!-- Feature strip (Glaxdu-style) -->
  <section class="feature-strip">
    <div class="container feature-strip__grid">
      <div class="feature-strip__item">
        <div class="feature-strip__icon">&#10003;</div>
        <h3>Certified Programs</h3>
        <p>Recognized certificates and marksheets for every completed course.</p>
      </div>
      <div class="feature-strip__item">
        <div class="feature-strip__icon">&#10003;</div>
        <h3>Student Verification</h3>
        <p>Employers and institutions can verify enrollment and results online.</p>
      </div>
      <div class="feature-strip__item">
        <div class="feature-strip__icon">&#10003;</div>
        <h3>Structured Curriculum</h3>
        <p>Clear syllabus, fixed duration, and transparent assessment.</p>
      </div>
    </div>
  </section>

  <main class="main-content">
    <section class="section section--about" id="about">
      <div class="container">
        <h2 class="section__title">About Us</h2>
        <p class="section__subtitle">A trusted name in computer education. We help students gain practical skills and earn recognized certificates.</p>
        <div class="about-grid">
          <div class="about-grid__text">
            <p class="about__lead">A trusted name in computer education.</p>
            <p>Satyam Computer Institute offers structured courses in computer fundamentals, office applications, internet, presentations, design, and accounting software. Our programs are designed to help students gain practical skills and earn recognized certificates that validate their qualifications for employers and institutions.</p>
          </div>
          <div class="about-grid__media">
            <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=800&q=80" alt="Learning and collaboration at Satyam Computer Institute" class="about__img">
          </div>
        </div>
      </div>
    </section>

    <section class="section section--courses" id="courses">
      <div class="container">
        <h2 class="section__title">Our Courses</h2>
        <p class="section__subtitle">Structured programmes with marksheets and certificates on completion.</p>
        <p class="courses-intro">We provide training in <strong>Basic Computer Education</strong>; <strong>Diploma and Advance Diploma in Computer Applications</strong>; <strong>Stenography (English &amp; Punjabi)</strong>; <strong>Typing Skills (English &amp; Punjabi)</strong>; <strong>Accounting Software (Tally)</strong>; <strong>Microsoft Office Applications</strong>; and related computer-based skill development courses.</p>
        <div class="courses-wrap">
          <div class="courses-visual">
            <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&q=80" alt="" class="courses__img">
          </div>
          <div class="courses-list-wrap">
            <ul class="courses-list">
              <li>Basic Computer Education</li>
              <li>Diploma &amp; Advance Diploma in Computer Applications</li>
              <li>Stenography (English &amp; Punjabi)</li>
              <li>Typing Skills (English &amp; Punjabi)</li>
              <li>Accounting Software (Tally)</li>
              <li>Microsoft Office Applications</li>
              <li>Knowing Computer &amp; Operating Computer</li>
              <li>Word Processing &amp; Spread Sheet, Internet, Presentation, Photoshop</li>
            </ul>
            <p class="section__note">Sessions with structured hours. Marksheets and certificates on completion.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--services" id="services">
      <div class="container">
        <h2 class="section__title">Our Services</h2>
        <p class="section__subtitle">Beyond training — we also help with documentation and government services.</p>
        <div class="services-grid">
          <article class="service-card">
            <div class="service-card__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3 class="service-card__title">Print &amp; Documentation</h3>
            <p class="service-card__text">Photocopy, printing, and document preparation for applications and certificates.</p>
          </article>
          <article class="service-card">
            <div class="service-card__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <h3 class="service-card__title">Aadhaar Update</h3>
            <p class="service-card__text">Aadhaar enrolment, update of details, and correction services.</p>
          </article>
          <article class="service-card">
            <div class="service-card__icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </div>
            <h3 class="service-card__title">PAN Card Services</h3>
            <p class="service-card__text">PAN card application, changes, and correction support.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--features">
      <div class="container">
        <h2 class="section__title">Why Choose Us</h2>
        <div class="features-grid">
          <article class="feature-card">
            <div class="feature-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
            </div>
            <h3 class="feature-card__title">Certified Programs</h3>
            <p class="feature-card__text">Recognized certificates and marksheets for every completed course.</p>
          </article>
          <article class="feature-card">
            <div class="feature-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="feature-card__title">Student Verification</h3>
            <p class="feature-card__text">Employers and institutions can verify enrollment and results online.</p>
          </article>
          <article class="feature-card">
            <div class="feature-card__icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            </div>
            <h3 class="feature-card__title">Structured Curriculum</h3>
            <p class="feature-card__text">Clear syllabus, fixed duration, and transparent assessment.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section--verify" id="verify-student">
      <div class="container">
        <div class="verify-card">
          <div class="verify-card__header">
            <span class="verify-card__icon" aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            </span>
            <h2 class="verify-card__title">Verify Student</h2>
            <p class="verify-card__desc">Enter the enrollment number to confirm student details and view marksheet.</p>
          </div>
          <form action="/verify" method="post" class="verify-form">
            <label for="enrollmentId" class="verify-form__label">Enrollment Number</label>
            <input type="text" id="enrollmentId" name="enrollmentId" value="<%= typeof enrollmentId !== 'undefined' ? enrollmentId : '' %>" placeholder="e.g. E64953" autocomplete="off" required class="verify-form__input">
            <% if (typeof error !== 'undefined' && error) { %>
              <p class="verify-form__error"><%= error %></p>
            <% } %>
            <button type="submit" class="btn btn--primary">Verify Student</button>
          </form>
        </div>
      </div>
    </section>

    <section class="section section--contact" id="contact">
      <div class="container">
        <h2 class="section__title">Contact</h2>
        <div class="contact-block">
          <p class="contact__name">Satyam Computer Institute</p>
          <p>For admissions and verification support, visit this portal or get in touch at the institute.</p>
          <p><strong>Address:</strong> Kauhrian Road Near Redison Palace, Dirba</p>
          <p><a href="mailto:satyamcomputerinstitute6@gmail.com">satyamcomputerinstitute6@gmail.com</a></p>
          <p><a href="tel:+919781187687">+91 9781187687</a></p>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container footer__inner">
      <div class="footer__col">
        <h4>About Us</h4>
        <p>Quality computer education and student verification. Empowering students with industry-relevant skills.</p>
      </div>
      <div class="footer__col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#courses">Courses</a></li>
          <li><a href="#services">Services</a></li>
          <li><a href="#verify-student">Verify Student</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Contact</h4>
        <p>Satyam Computer Institute</p>
        <p>Kauhrian Road Near Redison Palace, Dirba</p>
        <p><a href="mailto:satyamcomputerinstitute6@gmail.com">satyamcomputerinstitute6@gmail.com</a></p>
        <p><a href="tel:+919781187687">+91 9781187687</a></p>
      </div>
    </div>
    <div class="footer__bottom">
      <div class="container">
        <p>&copy; <%= new Date().getFullYear() %> Satyam Computer Institute. All rights reserved.</p>
      </div>
    </div>
  </footer>
</body>
</html>
